# API Key for models (Groq API Key "gsk_..." or OpenAI API Key "sk-...")
# Get a 100% free Groq key at: https://console.groq.com/keys
OPENAI_API_KEY="your-groq-or-openai-api-key-here"

# Model Base URL (Set to https://api.groq.com/openai/v1 for Groq, or omit/leave empty for standard OpenAI)
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# Model to use for generation (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768 for Groq; gpt-4o for OpenAI)
OPENAI_MODEL_NAME="llama-3.3-70b-versatile"

# Model to use for embeddings (e.g. all-MiniLM-L6-v2 for free local HuggingFace embeddings, or text-embedding-3-small for OpenAI)
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Path to store the FAISS vector database
VECTOR_STORE_PATH="data/vector_store"

# Chunk size for document splitting
CHUNK_SIZE=1000

# Chunk overlap for document splitting
CHUNK_OVERLAP=200

# API Server host
API_HOST="0.0.0.0"

# API Server port
API_PORT=8000

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Maximum concurrent requests for agents
MAX_CONCURRENT_REQUESTS=50

# API Key for accessing this service (optional)
API_KEY="your-api-key"

# Search API Key (optional)
SEARCH_API_KEY="your-search-api-key"
